{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"], "types": ["node", "vite/client"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "scripts/*.ts", "vite.config.ts"]
}
