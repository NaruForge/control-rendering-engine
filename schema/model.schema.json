{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 600
    },
    "groups": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "quantities": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "exclusive": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "symbol",
          "label",
          "exclusive"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "technology": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "external",
              "converter",
              "bus"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "boundary": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "members": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          }
        }
      },
      "required": [
        "label",
        "members"
      ],
      "additionalProperties": false
    },
    "links": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "capability": {
            "default": "bidirectional",
            "type": "string",
            "enum": [
              "forward",
              "bidirectional"
            ]
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "capability"
        ],
        "additionalProperties": false
      }
    },
    "modes": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "extends": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "flow": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "forward",
                "reverse",
                "bidirectional",
                "off"
              ]
            }
          },
          "controls": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "additionalProperties": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                  },
                  "role": {
                    "default": "unspecified",
                    "type": "string",
                    "enum": [
                      "unspecified",
                      "regulator",
                      "inner-loop",
                      "command",
                      "limit"
                    ]
                  }
                },
                "required": [
                  "quantity",
                  "role"
                ],
                "additionalProperties": false
              }
            }
          },
          "note": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "label",
          "group"
        ],
        "additionalProperties": false
      }
    },
    "focusQuantity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "notes": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "signals": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "nodes": {
          "minItems": 1,
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "enum": [
                  "reference",
                  "controller",
                  "plant",
                  "limiter",
                  "measurement"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "ports": {
                "default": [],
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                    },
                    "side": {
                      "type": "string",
                      "enum": [
                        "WEST",
                        "EAST",
                        "NORTH",
                        "SOUTH"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "side"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "ports"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "maxItems": 120,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "from": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                  },
                  "port": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                  }
                },
                "required": [
                  "node"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                  },
                  "port": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                  }
                },
                "required": [
                  "node"
                ],
                "additionalProperties": false
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "default": "signal",
                "type": "string",
                "enum": [
                  "signal",
                  "feedback"
                ]
              }
            },
            "required": [
              "id",
              "from",
              "to",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "description",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "description",
    "groups",
    "quantities",
    "stages",
    "links",
    "modes",
    "notes"
  ],
  "additionalProperties": false
}
