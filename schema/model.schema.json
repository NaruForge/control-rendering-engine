{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 800
    },
    "quantities": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "exclusive": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "symbol",
          "label",
          "exclusive"
        ],
        "additionalProperties": false
      }
    },
    "components": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "external",
              "converter",
              "bus",
              "subsystem"
            ]
          },
          "technology": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "powerLinks": {
      "default": [],
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "capability": {
            "default": "bidirectional",
            "type": "string",
            "enum": [
              "forward",
              "bidirectional"
            ]
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "capability"
        ],
        "additionalProperties": false
      }
    },
    "modes": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "extends": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "flow": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "forward",
                "reverse",
                "bidirectional",
                "off"
              ]
            }
          },
          "controls": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "additionalProperties": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "role": {
                    "default": "unspecified",
                    "type": "string",
                    "enum": [
                      "regulator",
                      "inner-loop",
                      "command",
                      "limit",
                      "unspecified"
                    ]
                  }
                },
                "required": [
                  "quantity",
                  "role"
                ],
                "additionalProperties": false
              }
            }
          },
          "note": {
            "type": "string",
            "maxLength": 600
          }
        },
        "required": [
          "id",
          "label",
          "group"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "default": [],
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "reference",
              "controller",
              "sum",
              "gain",
              "integrator",
              "transfer",
              "limiter",
              "plant",
              "measurement",
              "junction",
              "switch"
            ]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "math": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "ports": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "WEST",
                    "EAST",
                    "NORTH",
                    "SOUTH"
                  ]
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "sign": {
                  "type": "string",
                  "enum": [
                    "+",
                    "-"
                  ]
                }
              },
              "required": [
                "id",
                "direction",
                "side"
              ],
              "additionalProperties": false
            }
          },
          "modes": {
            "default": [],
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "ports",
          "modes"
        ],
        "additionalProperties": false
      }
    },
    "signals": {
      "default": [],
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "from": {
            "type": "object",
            "properties": {
              "block": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "port": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "block",
              "port"
            ],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "block": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "port": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "block",
              "port"
            ],
            "additionalProperties": false
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "default": "signal",
            "type": "string",
            "enum": [
              "signal",
              "feedback"
            ]
          },
          "quantity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "views": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "overview",
              "power",
              "control",
              "matrix"
            ]
          },
          "mode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "include": {
            "default": [],
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "focus": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "depth": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "direction": {
            "default": "RIGHT",
            "type": "string",
            "enum": [
              "RIGHT",
              "DOWN"
            ]
          },
          "grouped": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "include",
          "depth",
          "direction",
          "grouped"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "default": [],
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "quantities",
    "components",
    "powerLinks",
    "modes",
    "blocks",
    "signals",
    "views",
    "notes"
  ],
  "additionalProperties": false
}
