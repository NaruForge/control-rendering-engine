{
  "name": "control-rendering-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Model-first control architecture studio, portable diagrams and MCP tools.",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "language:generate": "langium generate",
    "typecheck": "tsc --noEmit",
    "build": "npm run language:generate && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run language:generate && npm run typecheck && npm test && vite build",
    "render": "tsx src/cli/main.ts render",
    "validate": "tsx src/cli/main.ts validate",
    "migrate": "tsx src/cli/main.ts migrate",
    "diff": "tsx src/cli/main.ts diff",
    "generate": "tsx scripts/generate.ts",
    "mcp": "tsx src/agent/server.ts",
    "lsp": "tsx src/language/server.ts --stdio",
    "export": "node scripts/export.mjs",
    "browser:install": "playwright install chromium",
    "test:browser": "npm run build && node scripts/browser-test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@xyflow/react": "^12.8.0",
    "elkjs": "0.12.0",
    "langium": "^4.1.0",
    "lucide-react": "^0.468.0",
    "mathjax-full": "3.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "langium-cli": "^4.1.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
