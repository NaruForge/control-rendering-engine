{
  "name": "control-rendering-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first engineering diagrams from a validated semantic model.",
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/engine.test.ts tests/feedback.test.ts",
    "check": "npm test && npm run build",
    "render": "node --experimental-strip-types src/cli.ts",
    "generate": "node scripts/generate.mjs",
    "validate": "npm run render -- --check",
    "export": "node scripts/export.mjs",
    "browser:install": "playwright install chromium",
    "test:browser": "npm run build && node scripts/browser-test.mjs"
  },
  "dependencies": { "elkjs": "^0.12.0", "yaml": "^2.8.1", "zod": "^4.1.0" },
  "devDependencies": { "@types/node": "^24.0.4", "playwright": "^1.56.0", "typescript": "~5.9.3", "vite": "^8.0.0" }
}
